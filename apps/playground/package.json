{
  "name": "@durable-agent/playground",
  "version": "0.0.1",
  "private": true,
  "description": "Playground app for testing durable-agent",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sequential": "tsx src/sequential-durability.ts",
    "retry": "tsx src/error-retry.ts",
    "blog": "tsx src/blog-pipeline.ts",
    "parallel": "tsx src/parallel-research.ts",
    "server": "tsx src/sleep-server.ts",
    "server:dev": "tsx watch src/sleep-server.ts",
    "express": "tsx src/express-example.ts",
    "express:dev": "tsx watch src/express-example.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.1",
    "@durable-agent/agent": "workspace:*",
    "@durable-agent/core": "workspace:*",
    "@openworkflow/backend-postgres": "^0.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openworkflow": "^0.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}