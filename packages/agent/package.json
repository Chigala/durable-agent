{
  "name": "@durable-agent/agent",
  "version": "0.0.2",
  "description": "Durable AI agent implementation",
  "author": "Chigala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chigala/durable-agent.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Chigala/durable-agent#readme",
  "bugs": {
    "url": "https://github.com/Chigala/durable-agent/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "durable",
    "workflow",
    "llm",
    "openai",
    "ai-sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "example:sequential": "tsx examples/sequential-durability.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^1.0.0",
    "@durable-agent/core": "workspace:*",
    "ai": "^6.0.3",
    "openworkflow": "^0.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openworkflow/backend-postgres": "^0.4.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=1.0.0",
    "ai": ">=6.0.0",
    "openworkflow": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "openworkflow": {
      "optional": false
    },
    "@ai-sdk/provider": {
      "optional": false
    },
    "ai": {
      "optional": false
    }
  }
}
