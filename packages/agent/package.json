{
  "name": "@durable-agent/agent",
  "version": "0.0.1",
  "description": "Durable AI agent implementation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@durable-agent/core": "workspace:*",
    "openworkflow": "^0.4.1",
    "@ai-sdk/provider": "^1.0.0",
    "ai": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "openworkflow": ">=0.4.0",
    "@ai-sdk/provider": ">=1.0.0",
    "ai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openworkflow": {
      "optional": false
    },
    "@ai-sdk/provider": {
      "optional": false
    },
    "ai": {
      "optional": false
    }
  }
}
